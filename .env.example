# Локальная конфигурация. Скопировать в .env. Секретов здесь нет.
YC_PROFILE=default
YC_CLOUD_ID=b1ghf5g8o4mhdlrvofo5
YC_FOLDER_ID=b1gcaq8clab0al7c1qhs
PROJECT_NAME=devops-diplom
SSH_USER=ubuntu
SSH_PUBLIC_KEY_PATH=$HOME/.ssh/id_ed25519.pub
SSH_PRIVATE_KEY_PATH=$HOME/.ssh/id_ed25519
# Внешний IPv4 вашей рабочей машины с маской /32; заполняется перед запуском.
ADMIN_CIDR=
# Должно совпадать с public-репозиторием Docker Hub и переменной IMAGE_NAME в GitHub Actions общего репозитория.
IMAGE_NAME=YOUR_DOCKERHUB_LOGIN/devops-diplom-app
IMAGE_TAG=main

# Необязательно: общий кэш уже скачанных Terraform providers.
# Если не задан, scripts/common.sh использует $HOME/.terraform.d/plugin-cache.
# TF_PLUGIN_CACHE_DIR=$HOME/.terraform.d/plugin-cache

# Необязательно: использовать зеркало Yandex для Terraform provider.
# Путь вычисляется из корня проекта, где scripts/common.sh читает .env.
# TF_CLI_CONFIG_FILE=$PWD/terraform/yandex-mirror.tfrc
